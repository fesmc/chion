! ============================================================
! chion_phys_const.nml — shared physical constants, standalone chion.
! ============================================================
!
! fesm-utils' phys_const schema (src/phys_constants.f90), read with
! phys_const_load and no defaults: a group must declare all 12
! primitives. Select the group with &chion : phys_const (default
! "Earth") and the file with &chion : phys_const_file.
!
! Read ONLY when the host passes no phys_const_class to chion_init. A
! coupled host (yelmox) hands chion the same record it gives every other
! component, and this file is then not opened.
!
! chion uses seven of these:
!     rho_ice -> rho_i    rho_w  -> rho_w    cp_ice -> ci
!     cp_w    -> cw       L_ice  -> Lm       g      -> grav (SEMIX SEB)
!     T0      -> T0
! Their values here are Chion.jl's (src/constants.jl:173-200), NOT the
! fesm-utils Earth reference set, so that standalone chion stays
! comparable to Chion.jl (validation/). The other five are the Earth
! reference values; chion does not use them.
!
! chion's own constants (snow, albedo, SEB, scheme flags) are the
! &chion_const group of input/chion_defaults.nml. See
! docs/porting_notes.md D28.
! ============================================================

&Earth

    g            = 9.81         ! [m s-2]      Gravitational acceleration (SEMIX SEB)
    T0           = 273.15       ! [K]          Reference freezing temperature

    rho_ice      =  917.0       ! [kg m-3]     Density of ice           (Chion.jl; Earth ref 910)
    rho_w        = 1000.0       ! [kg m-3]     Density of pure water
    rho_sw       = 1028.0       ! [kg m-3]     Density of seawater          (unused)
    rho_asth     = 3300.0       ! [kg m-3]     Density of the asthenosphere (unused)

    L_ice        = 334000.0     ! [J kg-1]     Latent heat of fusion     (Chion.jl; Earth ref 3.335e5)

    cp_ice       = 2110.0       ! [J kg-1 K-1] Specific heat capacity of ice
    cp_w         = 4181.0       ! [J kg-1 K-1] Specific heat capacity of water (Chion.jl; Earth ref 4187)
    cp_ocn       = 3974.0       ! [J kg-1 K-1] Ocean mixed layer             (unused)

    T_pmp_beta   = 9.8e-8       ! [K Pa-1]     Melting-point pressure slope  (unused)
    area_seasurf = 3.618e8      ! [km2]        Global sea-surface area       (unused)

/
