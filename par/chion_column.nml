! ============================================================
! chion_column.nml — runnable single-column example.
! ============================================================
!
! A complete, runnable configuration for a one-column chion run driven
! by synthetic forcing. This is the parameter file the WP15 driver
! chion_column.x takes as its single command-line argument:
!
!     libchion/bin/chion_column.x par/chion_column.nml
!
! Only OVERRIDES need to appear here. Every chion group is validated
! against input/chion_defaults.nml, so anything omitted below takes the
! default from there, and any name that does not exist there is reported
! as an error rather than silently ignored.
!
! The &ctrl group is the DRIVER's, not the library's. chion never reads
! it, and it is therefore not validated against the defaults schema.
! ============================================================


! ============================================================
! &ctrl — driver control (WP15; not read by the chion library)
! ============================================================

&ctrl
    ncol             = 1                    ! [1] Number of independent columns
    time_init        = 0.0                  ! [d] Start time
    time_end         = 3650.0               ! [d] End time (10 years)
    dt               = 1.0                  ! [d] Timestep
    dt_out           = 30.0                 ! [d] Output interval

    ! Synthetic forcing: a sinusoidal annual cycle in air temperature and
    ! insolation, with precipitation split into snow below t_snow_max.
    latitude         = 70.0                 ! [deg N] Column latitude
    surface_height   = 1500.0               ! [m] Surface elevation
    H_ice            = 1000.0               ! [m] Ice thickness (ITM only)

    t2m_mean         = 263.15               ! [K] Annual mean air temperature
    t2m_amplitude    = 12.0                 ! [K] Half-amplitude of the annual cycle
    t2m_phase        = 200.0                ! [d] Day of year of the warmest day

    pr_mean          = 1.5e-5               ! [kg m-2 s-1] Annual mean precipitation rate
    t_snow_max       = 273.15               ! [K] Above this, precipitation falls as rain

    sw_mean          = 150.0                ! [W m-2] Annual mean downward shortwave
    sw_amplitude     = 130.0                ! [W m-2] Half-amplitude of its annual cycle
    wind_speed       = 4.0                  ! [m s-1] Constant wind speed

    file_out         = "chion_column.nc"    ! Output file, written to the run directory
/


! ============================================================
! chion library groups
! ============================================================

&chion
    model            = "bessi"              ! "bessi" | "pdd" | "itm"
    phys_const_file  = "input/chion_phys_const.nml"
    phys_const       = "Earth"
    restart          = "None"
/

&bessi
    Ntot             = 15                   ! [1] Layer capacity per column
    mass_max         = 500.0                ! [kg m-2] Split trigger
    mass_split       = 300.0                ! [kg m-2] Mass left below after a split
    mass_min         = 100.0                ! [kg m-2] Merge trigger

    ! Substepping is off. Enabling it changes the albedo scheme as well as
    ! the shortwave resolution — see the notes in input/chion_defaults.nml.
    diurnal_shortwave_substeps = False
/

&pdd
    ddf_snow            = 3.0               ! [kg m-2 K-1 d-1]
    ddf_ice             = 8.0               ! [kg m-2 K-1 d-1]
    refreezing_fraction = 0.6               ! [1]
    temperature_sigma   = 5.0               ! [K]
    pdd_method          = "pism"            ! "simple" | "pism"
/

! ITM needs the host to supply insolation, surface height, ice thickness
! and the ANNUAL positive-degree-day total; the driver's &ctrl group
! above provides all four.
!
! NOTE: itm_par_load reads the legacy nml path, so if this group is
! present it must be COMPLETE. See chion_itm_par_load in src/chion_api.f90.
&itm
    trans_a             = 0.46              ! [1]
    trans_b             = 6e-5              ! [m-1]
    trans_c             = 0.01              ! [1] unused
    itm_c               = -45.0             ! [W m-2]
    itm_t               = 10.0              ! [W m-2 K-1]
    itm_b               = -2.0              ! [W m-2 deg-1]
    itm_lat0            = 65.0              ! [deg N]
    H_snow_max          = 5000.0            ! [mm w.e.]
    Pmaxfrac            = 0.6               ! [1]
    H_snow_crit_desert  = 10.0              ! [mm w.e.]
    H_snow_crit_forest  = 100.0             ! [mm w.e.]
    melt_crit           = 0.5               ! [mm d-1]
    alb_ocean           = 0.1               ! [1]
    alb_land            = 0.2               ! [1]
    alb_forest          = 0.1               ! [1]
    alb_ice             = 0.4               ! [1]
    alb_snow_dry        = 0.8               ! [1]
    alb_snow_wet        = 0.65              ! [1]
    firn_fac            = 0.0266            ! [K (mm w.e.)-1]
/
