! ============================================================
! chion_grid.x — gridded run driven by a forcing NetCDF file
! ============================================================
!
! Usage:  chion_grid.x path/to/this_file.nml
!
! The &ctrl group is the DRIVER's, not the library's. chion never reads
! it, and it is therefore not validated against the defaults schema.
! Everything below &ctrl is library configuration and IS validated
! against input/chion_defaults.nml.
!
! A forcing file is required. It must provide, at minimum:
!   (time,y,x)  air temperature, snowfall, rainfall, downward shortwave
!   (y,x)       latitude, surface elevation, and a mask
! The mask selects which cells become columns, so only the points you
! care about are computed. Set name_mask = "None" to take every cell.
!
! Note the driver currently supports the (time,y,x) layout only, and does
! not read the optional longwave / turbulent-flux / humidity fields that
! Chion.jl's load_forcing_file accepts. See tests/chion_grid.f90.
! ============================================================

&ctrl
    forcing_source      = "file"            ! "file" | "domain"

    file_forcing        = "forcing.nc"      ! Input forcing file
    file_out            = "chion_grid.nc"   ! Output, written to the run directory

    name_x              = "x"               ! Coordinate variables
    name_y              = "y"
    name_time           = "time"

    name_t2m            = "TT"              ! (time,y,x) forcing variables
    name_sf             = "SF"
    name_rf             = "RF"
    name_swd            = "SWD"

    name_mask           = "mask"            ! (y,x) static, or "None" for all cells
    mask_threshold      = 0.0               ! [1] cells with mask > threshold become columns
    name_lat            = "LAT"             ! (y,x) static, or "None"
    name_zs             = "SH"              ! (y,x) static, or "None"

    t2m_in_celsius      = .FALSE.           ! Convert TT by +273.15
    precip_in_mmwe_day  = .FALSE.           ! Convert SF/RF by /86400
    wind_default        = 5.0               ! [m s-1] used; no wind variable is read
    dust_dep_default    = 0.0              ! [kg m-2 s-1] Uniform dust deposition (SEMIX albedo)
    rh_default          = 0.0              ! [1] Uniform relative humidity (0 = no humidity forcing)

    dt                  = -1.0              ! [d] <= 0 infers the step from the time axis
    dt_out              = 30.0              ! [d] Output interval
/

! ============================================================
! &chion — top-level library configuration
! ============================================================

&chion
    model               = "bessi"           ! "bessi" | "pdd" | "itm"
    phys_const          = "Earth"           ! Group in input/chion_phys_const.nml
    phys_const_file     = "input/chion_phys_const.nml"
    restart             = "none"            ! Restart file, or "none"
/

! ============================================================
! &bessi — layered snowpack model
! ============================================================

&bessi
    Ntot                = 15                ! [1] Maximum number of layers
    mass_max            = 500.0             ! [kg m-2] Split the surface layer above this
    mass_split          = 300.0             ! [kg m-2] Mass left in the lower half on split
    mass_min            = 100.0             ! [kg m-2] Merge the surface layer below this
    density_init        = 300.0             ! [kg m-3] Initial layer density
    temperature_init    = 273.0             ! [K] Initial layer temperature

    diurnal_shortwave_substeps          = .FALSE.   ! Resolve the diurnal shortwave cycle
    diurnal_shortwave_threshold         = 0.0       ! [W m-2] Peak-minus-mean to activate
    diurnal_shortwave_max_substeps      = 3         ! [1] Substeps per day when active
    diurnal_shortwave_min_air_temperature = 265.15  ! [K] Below this, do not substep
    diurnal_temperature_cycle           = .FALSE.   ! Add a diurnal air-temperature cycle
    diurnal_temperature_amplitude       = 5.0       ! [K] Half-amplitude of that cycle
/

! ============================================================
! &pdd — bulk positive-degree-day model
! ============================================================

&pdd
    pdd_method          = "pism"            ! "pism" | "simple"
    ddf_snow            = 3.0               ! [kg m-2 K-1 d-1] Snow degree-day factor
    ddf_ice             = 8.0               ! [kg m-2 K-1 d-1] Ice degree-day factor
    refreezing_fraction = 0.6               ! [1] Fraction of snow melt that refreezes
    temperature_sigma   = 5.0               ! [K] Unresolved temperature variability
    H_snow_max          = 5000.0            ! [kg m-2] Snowpack cap; excess -> ice
/

! ============================================================
! &itm — insolation-temperature-melt model
! ============================================================
!
! NOTE: itm_par_load reads the legacy nml path, so if this group is
! present it must be COMPLETE. See chion_itm_par_load in src/chion_api.f90.

&itm
    trans_a             = 0.46              ! [1]
    trans_b             = 6e-5              ! [m-1]
    trans_c             = 0.01              ! [1] unused
    itm_c               = -45.0             ! [W m-2]
    itm_t               = 10.0              ! [W m-2 K-1]
    itm_b               = -2.0              ! [W m-2 deg-1]
    itm_lat0            = 65.0              ! [deg N]
    H_snow_max          = 5000.0            ! [mm w.e.]
    Pmaxfrac            = 0.6               ! [1]
    H_snow_crit_desert  = 10.0              ! [mm w.e.]
    H_snow_crit_forest  = 100.0             ! [mm w.e.]
    melt_crit           = 0.5               ! [mm d-1]
    alb_ocean           = 0.1               ! [1]
    alb_land            = 0.2               ! [1]
    alb_forest          = 0.1               ! [1]
    alb_ice             = 0.4               ! [1]
    alb_snow_dry        = 0.8               ! [1]
    alb_snow_wet        = 0.65              ! [1]
    firn_fac            = 0.0266            ! [K (mm w.e.)-1]
/
