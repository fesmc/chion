# Generated by configme. Anchored to the repo root: config/Makefile is the
# TEMPLATE and must stay tracked. An unanchored "Makefile" pattern matches at
# every level and silently excludes it.
/Makefile

# Build products. Every flavour other than the production sp build
# (precision=dp, legacy_chion=1, fpsafe=1) gets its own suffixed directories,
# created by make (config/Makefile: psuffix).
libchion/include/*
libchion/bin/*
libchion/include-*/
libchion/bin-*/
!libchion/include/.gitkeep
!libchion/bin/.gitkeep
*.o
*.mod
*.a
*.x

